# Port the hub listens on
PORT=4800

# Secret used to sign session cookies. Required in production.
# Generate one with:  openssl rand -hex 48
SESSION_SECRET=change-me

NODE_ENV=production

# SQLite location. Relative paths resolve against the server package.
DATABASE_PATH=data/beacon.db

# Set to 1 only when the hub sits behind a reverse proxy that terminates TLS,
# so secure cookies and real client IP addresses work correctly.
TRUST_PROXY=0

# Where the hub looks for new releases. Leave unset to use the project default.
# BEACON_UPDATE_REPO=owner/repo

# Installer scripts and the agent bundle served to devices.
# PUBLIC_DIR=/app/public

# debug | info | warn | error
LOG_LEVEL=info
